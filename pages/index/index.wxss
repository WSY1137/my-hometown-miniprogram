/* 家乡印记模块入口样式 */
.imprint-entry {
  padding: 20px;
  margin-top: 20px;
  margin-bottom: 20px;
}

.imprint-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1aad19;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.imprint-btn:hover {
  background-color: #179b16;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
}

.imprint-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.imprint-text {
  font-size: 36rpx;
  font-weight: bold;
}

.imprint-arrow {
  font-size: 28rpx;
  margin-left: 10rpx;
}

