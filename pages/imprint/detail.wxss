/* detail.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  position: relative;
}

/* 加载提示 */
.loading {
  padding: 100rpx;
  text-align: center;
  color: #999;
}

/* 印记详情 */
.detail {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 标题区域 */
.header {
  margin-bottom: 30rpx;
  padding: 0 20rpx 0 120rpx; /* 添加左侧padding，避免与返回按钮重叠 */
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 60rpx;
  margin-bottom: 20rpx;
}

.meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.type {
  display: inline-block;
  color: #07c160;
  background-color: #f0f9f4;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 图片区域 */
.image-scroll {
  margin-bottom: 30rpx;
}

.image-wrapper {
  display: flex;
}

.image {
  width: 690rpx;
  height: 450rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
}

/* 内容区域 */
.content {
  margin-bottom: 40rpx;
}

.content text {
  font-size: 32rpx;
  color: #666;
  line-height: 52rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.like-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 40rpx;
  background-color: #f0f9f4;
  color: #07c160;
  border-radius: 30rpx;
  font-size: 32rpx;
}

.like-btn::after {
  border: none;
}

.like-icon {
  font-size: 36rpx;
}

.delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 40rpx;
  background-color: #fff1f0;
  color: #ee0a24;
  border-radius: 30rpx;
  font-size: 32rpx;
}

.delete-btn::after {
  border: none;
}

.delete-icon {
  font-size: 36rpx;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 30rpx;
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.9);
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  padding: 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.back-btn::after {
  border: none;
}

/* 类型标签样式 */
.type-scenic {
  color: #1989fa;
  background-color: #e6f7ff;
}

.type-food {
  color: #ff7a45;
  background-color: #fff1e6;
}

.type-story {
  color: #722ed1;
  background-color: #f9f0ff;
}