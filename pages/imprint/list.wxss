/* list.wxss */
.container {
  background-color: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 主滚动区域 */
.scroll-container {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 50rpx;
  padding-top: calc(120rpx + env(safe-area-inset-top)); /* 避开导航栏高度和顶部安全区域 */
  box-sizing: border-box;
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  padding-top: calc(30rpx + env(safe-area-inset-top));
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  min-height: 120rpx;
  box-sizing: border-box;
  height: auto;
}

.navbar::after {
  content: none;
}

.navbar .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 导航栏右侧区域 */
.navbar .publish-btn {
  margin-left: auto; /* 确保按钮在右侧 */
}

.publish-btn {
  width: 140rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #07c160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  border: none;
  box-sizing: border-box;
  z-index: 10;
  opacity: 1;
  pointer-events: auto;
}

.publish-btn:active {
  background-color: #06ad56;
}

/* 加载提示 */
.loading {
  padding: 60rpx;
  text-align: center;
  color: #999;
}

/* 热门印记区域 */
.hot-section {
  margin-top: 20rpx;
  background-color: #fff;
  padding-bottom: 30rpx;
}

.section-header {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.hot-scroll {
  padding: 20rpx 30rpx;
}

.hot-item {
  width: 280rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f9f9f9;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.hot-image {
  width: 100%;
  height: 200rpx;
}

.hot-content {
  padding: 20rpx;
}

.hot-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.hot-type {
  display: inline-block;
  font-size: 24rpx;
  color: #07c160;
  background-color: #f0f9f4;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.hot-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.hot-likes {
  display: flex;
  align-items: center;
}

/* 所有印记列表 */
.list-section {
  margin-top: 20rpx;
  background-color: #fff;
}

.imprint-list {
  padding: 0 30rpx;
}

.imprint-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.imprint-item:last-child {
  border-bottom: none;
}

.item-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.item-type {
  display: inline-block;
  font-size: 24rpx;
  color: #07c160;
  background-color: #f0f9f4;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.item-likes {
  display: flex;
  align-items: center;
}

.item-time {
  font-size: 22rpx;
}

/* 空状态 */
.empty {
  padding: 100rpx;
  text-align: center;
  color: #999;
}

/* 类型标签样式 */
.type-scenic {
  color: #1989fa;
  background-color: #e6f7ff;
}

.type-food {
  color: #ff7a45;
  background-color: #fff1e6;
}

.type-story {
  color: #722ed1;
  background-color: #f9f0ff;
}